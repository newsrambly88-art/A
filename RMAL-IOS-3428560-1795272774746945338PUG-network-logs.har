   key = key.replace('?', '');\n            window.queryParams[key] = val;\n        });\n    }\n    window.queryParams.version = window.queryParams.version || '_local';\n\n    sendMessageToApp(`applogin://req_login_complete`);\n    return \t{\n        storeType: window.queryParams.store || 'f',\n        isAppGame: window.queryParams.store == 'a' || window.queryParams.store == 'i',\n        ios13: (window.queryParams.ios13 == '1') || false,\n        ios17: (window.queryParams.ios17 == '1') || false,\n        countryCode: (window.queryParams.countryCodeLine) ? window.queryParams.countryCodeLine.toUpperCase() : 'US',\n        language: window.queryParams.language || 'us',\n        lineReLogin: window.queryParams.lineReLogin || '0',\n        existUser: window.queryParams.existUser || '1',\n    };\n}\n\n\nfunction phaser_preload(){\n    game.scale.pageAlignHorizontally = true;\n    game.scale.pageAlignVertically = true;\n    game.scale.refresh();\n    game.load.crossOrigin = 'anonymous';\n    game.scale.scaleMode = Phaser.ScaleManager.USER_SCALE;\t\t\t\n\n    game.input.maxPointers = 1;  // í¬ì¸í° ìë¥¼ 1ê°ë¡ ì í\n\n    var width = Math.max(window.innerWidth, document.documentElement.clientWidth);\n    var height = Math.max(window.innerHeight, document.documentElement.clientHeight);\n    var scale = Math.min(width / 720, height / 1280);\n    game.scale.setUserScale(scale, scale, 0, 0);\n        \n    var _path = 'assets/images/app/no_hash/';\n    \n    if(window.info.isLocalhost) {\n       sharedPath = _path;\n    }\n    \n    game.load.atlasJSONArray('v2_nineslice_atlas', sharedPath+'v2_nineslice_atlas.png?ver=2', sharedPath+'v2_nineslice_atlas.json?ver=2');\n    game.load.atlasJSONArray('app_login_atlas', sharedPath+'app_login_atlas_2.png?ver=3', sharedPath+'app_login_atlas_2.json?ver=3');\n\n}\nfunction phaser_create(){\n    game.add.image(360, 640, 'app_login_atlas', 'login_bg').anchor.set(0.5);\n    var img = game.add.image(360, 200, 'app_login_atlas', 'login_bg_logo').anchor.set(0.5, 0);\n\n    loadLogin();\n\n    //**\n    // ì½ê´ ëì ìì  ë³ê²½\n    // ìë² ë¡ê·¸ì¸(init/v3) ì ê²°ê³¼ì ë°ë¼ ì½ê´ ëì íì ë¸ì¶\n    // 26-05-27 */\n    \n    // if(window.logininfo.existUser == '0'){\n    //     openPolicy();\n    // }\n\n    sendMessageToApp(`applogin://onpageready`);\n}\n\nfunction loadLogin()\n{\n    rootLogin = game.add.group();\n    rootLogin.visible = true;\n\n    var btn_pos = {\n            facebook: 0,\n            apple: 0,\n            line: 0,\n            guest: 0,\n        };\n\n    if (window.queryParams.store == 'i')\n    {\n        // ios\n        btn_pos.facebook = 782;\n        if (window.logininfo.ios13) {\n            btn_pos.apple = 897;\n            btn_pos.guest = 1139;\n\n            game.add.button(360, btn_pos.apple,'app_login_atlas', login_apple, null, null, 'login_btn_apple_Login', null, null, rootLogin).anchor.set(0.5, 0);\n        } else {\n            btn_pos.guest = 1013;\n        }\n\n        game.add.button(360, btn_pos.facebook,'app_login_atlas', login_facebook, null, null, 'login_btn_Facebook_Login', null, null, rootLogin).anchor.set(0.5, 0);\n        game.add.button(360, btn_pos.guest,'app_login_atlas', login_guest, null, null, 'login_btn_Guest-Login', null, null, rootLogin).anchor.set(0.5, 0);\n    }\n    else if (window.queryParams.store == 'a')\n    {\n        // android\n        btn_pos.facebook = 830;\n        btn_pos.guest = 967;\n\n        var fb_login_btn = game.add.button(360, btn_pos.facebook,'app_login_atlas', login_facebook, null, null, 'login_btn_Facebook_Login', null, null, rootLogin).anchor.set(0.5, 0);\n        game.add.button(360, btn_pos.guest,'app_login_atlas', login_guest, null, null, 'login_btn_Guest-Login', null, null, rootLogin).anchor.set(0.5, 0);\n    }\n    else\n    {\n        // unknown platform\n        game.add.button(360, 875,'app_login_atlas', login_guest, null, null, 'login_btn_Guest-Login', null, null, rootLogin).anchor.set(0.5);\n    }    \n}    \n\nfunction colorize(phaserText){\n    var regColorTag = /<color=#?(?:(?:[0-9a-fA-F]{2}){3}|(?:[0-9a-fA-F]){3})>.*?<\\/color>/;\n    var regHexColor = /(?:(?:[0-9a-fA-F]{2}){3}|(?:[0-9a-fA-F]){3})/;\n\n    let originColor = phaserText.style.fill;\n    let match;\n    let s = 0;\n    while ((match = regColorTag.exec(phaserText.text)) != null) {\n\n        let idx = s + match.index;\n        let wordCount = match[0].length - 23;\n\n        let newline_check = phaserText.text;\n        newline_check = newline_check.substring(0, match.index);\n        newline_check = newline_check.split(/\\r?\\n/);\n        let newline_cnt = 0;\n        if (newline_check && newline_check.length > 0) {\n            newline_cnt = newline_check.length-1;\n        }\n\n        let t1 = phaserText.text.substring(s, match.index);\n        let t2 = phaserText.text.substring(s + match.index + 15, s + match.index + 15 + wordCount);\n        let t3 = phaserText.text.substring(s + match.index + 15 + wordCount + 8, phaserText.text.length);\n        phaserText.text = `${t1}${t2}${t3}`;\n        phaserText.addColor(`#${match[0].match(regHexColor)}`, match.index-newline_cnt);\n        phaserText.addColor(originColor, match.index + wordCount-newline_cnt);\n    }\n}\n\nfunction openPolicy() {\n    rootLogin.visible = false;\n\n    setDimmed(true);\n\n    rootPolicy = game.add.group();\n\n    this._msgPopup = new PopupWelcome(this.game, rootPolicy);\n}\n\n\nfunction OnClickSeeMoreBtn1()\n{\n    var url = 'https://corp.playlinks.com/terms-of-service-eng';\n    location.href = `applogin://openurl?url=${encodeURIComponent(url)}`;\n}\n\nfunction OnClickSeeMoreBtn2()\n{\n    var url = 'https://corp.playlinks.com/privacy-policy-eng';\n    location.href = `applogin://openurl?url=${encodeURIComponent(url)}`;\n}\n\nfunction OnClickAgreeToStartBtn()\n{\n    policyClose();\n}\n\nfunction policyClose()\n{\n    setDimmed(false);\n    rootPolicy.visible = false;\n\n    sendMessageToApp('applogin://policy_confirm');\n    \n    rootLogin.visible = true;\n}\n\nfunction login_facebook() {\n\n    if(window.logininfo.ios17 == '1' && window.logininfo.storeType == 'i'){\n        location.href = 'applogin://att_status';\n        appleATTStatusCallback = (status)=>{\n            if(status == '0'){\n                //open facebook login not available popup\n                openFacebookLoginNotAvailPopup();\n            }\n            else{\n                req_login('facebook');\n            }\n        }\n    }\n    else{\n        req_login('facebook');\n    }\n}\n\nfunction openFacebookLoginNotAvailPopup(){\n\n    setDimmed(true);\n\n    if(!rootFacebookInfo){\n        rootFacebookInfo = game.add.group();\n    }\n\n    this._msgPopup = new PopupATTAlert(this.game, rootFacebookInfo);    \n}\n\nfunction login_apple() {\n    req_login('apple');\n}\n\nfunction login_guest() {\n    req_login('guest');\n}\n\n    \n/**\n * ë¹ë íê²½ì ë°ë¼ static data ì url ì ë°ííë¤\n * @returns static url\n */\nfunction getStaticUrl(){\n    // static locale\n    window.info.app_env = window.location.host.split('.')[0];\n    var staticdata_locale_url = 'https://slotmate.playlinks.app/resource/static/sheet.json?name=locale';\n    if (window.info.app_env != 'live' && window.info.app_env != 'livetest') {\n        staticdata_locale_url = 'https://slotmate-stage.playlinks.app/resource/static/sheet.json?name=locale';\n        if (window.info.app_env != 'dev') {\n            staticdata_locale_url = 'https://slotmate-dev.playlinks.app/resource/static/sheet.json?name=locale';\n        }\n    }\n    return staticdata_locale_url;\n}    \n\nfunction req_login(type)\n{\n    var login_types = ['facebook','apple','guest'];\n    if (-1 < login_types.indexOf(type))\n    {\n        if (!loading || !loading.visible)\n        {\n            showLoading();\n            sendMessageToApp(`applogin://req_login?type=${type}&restart=0`);\n        }\n    }\n    else\n    {\n        console.log('unknown login type!!!');\n    }\n}\n\nfunction setDimmed(visible)\n{\n\n    if (!_dimmed) {\n        var grp = game.add.graphics(0,0);\n        grp.beginFill(0);\n        grp.drawRect(0,0,720,1280);\n        grp.endFill();\n        grp.alpha = 0.7;\n        _dimmed = grp;\n    }\n    _dimmed.visible = visible;\t\n}\n\nfunction showLoading() {\n\n    if(!loading){\n        loading = game.add.sprite(360, 640, 'app_login_atlas', 'slot_loading');\n        loading.anchor.set(0.5);\n    }\n    if (!loading.visible){\n\n        setDimmed(true);\n\n        loading.angle = 0;\n        game.tweens.removeFrom(loading);\n        game.add.tween(loading).to({angle: 90 * 100}, 100000, Phaser.Easing.Linear.None, true, 0);\n        loading.visible = true;\n    }\n}\n\nfunction hideLoading() {\n    if (loading)\n    {\n        game.tweens.removeFrom(loading);\n        loading.visible = false;\n    }\n\n    setDimmed(false);\n}\n\n\n\nfunction openPopup(params) {\n    this._msgPopup = new PopupMsg(this.game);\n    this._msgPopup.setText(params.msg);\n    this._msgPopup.setConfirm(params.callback);\n    this._msgPopup.setCloseButtonEnabled(params.close_enable);\n}\n\nfunction close() {\n    if(!game)\n        return;\n    game.add.tween(fRoot).to({x: 300}, 200, Phaser.Easing.Sinusoidal.In, true, 0).onComplete.add(()=>{fRoot.visible = false; hideLoading();});\n    game.add.tween(fRoot).to({alpha: 0}, 250, Phaser.Easing.Sinusoidal.In, true, 0);\n}\n\nfunction msgBoxConfirm(msg, confirmText = null, callback = null, closeFirst = true) {\n    var params = {\n        //msgBoxType: MsgBoxType.Confirm,\n        msg: msg,\n        confirmButtonText: confirmText,\n        callback: callback,\n        dimmed: true,\n        closeFirst : closeFirst,\n    };\n\n    return openPopup(params);\n}\n\nfunction loginFailed_base64(error_base64)\n{\n    var error = Base64.decode(error_base64||'');\n    loginFailed(error);\n}\n\nfunction loginFailed(error)\n{\n    hideLoading();\n    if (rootLogin) {\n        rootLogin.visible = false;\n    }\n\n    if (error == '' ||\n        error == 'AppleAuth.Native.AppleError' ||\n        error.startsWith('User cancelled') ||\n        error.startsWith('Login canceled') || \t\t\t//'User cancelled or interrupted the login process.'\n        error.startsWith('Web login flow failed')) {\t//'Web login flow failed while auth process.'\n        rootLogin.visible = true;\n        return;\n    }\n\n    msgBoxConfirm(error, \"OK\", ()=>{\n        if (rootLogin) {\n            rootLogin.visible = true;\n        }\n    });\n}\n\n\n//from APP\nfunction appleATTStatus(status){\n    if(appleATTStatusCallback){\n        appleATTStatusCallback(status);\n    }\n}\n\nfunction sendMessageToApp(msg){\n    if(window.info.isLocalhost){\n        if(msg.startsWith('applogin://req_login?')){\n            location.href = location.origin+'/index.html?appid=388241778302042&uid=2791491394201883&policy_confirm=1&store=i&ios13=0&fblogin=1&fb_tracking=1&applelogin=0&automerge=fb_asid&appver=1.2.0.4&launchurl=&countryCode=KR&language=&name_enc=1&store_enable=1&ad_id=00000000-0000-0000-0000-000000000000&af_id=1718951731957-2918300020343946767&af_media_source=&af_campaign_id=&noti_perm=Authorized&onesignal_id=aef982a3-92cd-4753-a162-0855ad0abc88&name=R1VFU1Q=&picture=&account_site=aos_audid&audid=3057ae59b1bcdd255d8aa1c3db495dcf&platform_token=&existUser=0';\n        }\n    }\n    else{\n        location.href = msg;\n    }\n}\n\n\n\nclass PopupWelcome extends Phaser.Group {\n\tconstructor(aGame, aParent, aName, aAddToStage, aEnableBody, aPhysicsBodyType) {\n\t\t\n\t\tsuper(aGame, aParent, aName, aAddToStage, aEnableBody, aPhysicsBodyType);\n\t\t\n\t\tvar _root = this.game.add.group(this);\n\t\t_root.position.set(360, 640);\n\t\t_root.pivot.set(340, 350);\n\t\t\n\t\tthis.game.cache.addNinePatch('btn_navy_9slice', 'v2_nineslice_atlas', 'btn_navy_9slice', 20, 20, 20, 20);\n\t\tlet sliced = new Phaser.NinePatchImage(this.game, 0, 0, 'btn_navy_9slice');\n\t\tsliced.targetWidth = 680;\n\t\tsliced.targetHeight = 700;\n\t\tsliced.UpdateImageSizes();\n\t\t_root.addChild(sliced);\n\n\t\tthis.game.cache.addNinePatch('popup_title_bg_9slice', 'v2_nineslice_atlas', 'popup_title_bg_9slice', 20, 20, 20, 20);\n\t\tsliced = new Phaser.NinePatchImage(this.game, 0, 0, 'popup_title_bg_9slice');\n\t\tsliced.targetWidth = 680;\n\t\tsliced.targetHeight = 80;\n\t\tsliced.UpdateImageSizes();\n\t\t_root.addChild(sliced);\n\n\t\tconst title = this.game.add.text(340, 40, 'WELCOME', {\"font\":\"37px Roboto-Medium\",\"fill\":\"#ffffff\",\"stroke\":\"#161616\",\"strokeThickness\":3,\"align\":\"center\"}, _root);\n\t\ttitle.anchor.set(0.5, 0.5);\n\n\t\t// const closeButton = this.game.add.button(610.0, 40.0, 'app_login_atlas', () => this.destroy(), _root, null, 'popup_btn_close', null, null, _root);\n\t\t// closeButton.anchor.set(0.5, 0.5);\n\n\t\tconst image = this.game.add.image(340, 200, 'app_login_atlas', 'txt_welcome', _root);\n\t\timage.anchor.set(0.5, 0.5);\n\n\t\tvar btnTerms = this.game.add.button(340, 350, 'app_login_atlas', () => OnClickSeeMoreBtn1(), this, null, 'btn_terms_of_service', null, null, _root);\n\t\tbtnTerms.anchor.set(0.5, 0.5);\n\n\t\tvar btnPolicy = this.game.add.button(340, 450, 'app_login_atlas', () => OnClickSeeMoreBtn2(), this, null, 'privacy_policy', null, null, _root);\n\t\tbtnPolicy.anchor.set(0.5, 0.5);\n\n\t\tvar btnAgree = this.game.add.button(340, 610, 'app_login_atlas', () => {\n            OnClickAgreeToStartBtn();\n            this.destroy();\n        }, this, null, 'btn_agree', null, null, _root);\n\t\tbtnAgree.anchor.set(0.5, 0.5);\n\t}\n}\n\nclass PopupATTAlert extends Phaser.Group {\n\tconstructor(aGame, aParent, aName, aAddToStage, aEnableBody, aPhysicsBodyType) {\n\t\t\n\t\tsuper(aGame, aParent, aName, aAddToStage, aEnableBody, aPhysicsBodyType);\n\t\t\n\t\tvar _root = this.game.add.group(this);\n\t\t_root.position.set(360, 640);\n\t\t_root.pivot.set(340, 450);\n\t\t\n\t\tthis.game.cache.addNinePatch('btn_navy_9sl